{
  "name": "gen-yu-academy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write public server scripts tests docs README.md package.json",
    "setup:staging": "node --env-file-if-exists=.env scripts/setup-staging.mjs",
    "test:staging": "node --env-file-if-exists=.env scripts/verify-staging.mjs",
    "build:portal": "node scripts/build-portal.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "@electric-sql/pglite": "0.5.12"
  }
}
